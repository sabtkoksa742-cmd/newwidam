# استخدام نسخة مستقرة وخفيفة من Node.js
FROM node:20-alpine

# تحديد مجلد العمل داخل السيرفر السحابي
WORKDIR /app

# نسخ ملفات الحزم أولاً لتسريع عملية التثبيت
COPY package*.json ./

# تثبيت كافة المكتبات البرمجية للمشروع (node_modules) تلقائياً
RUN npm install

# نسخ بقية الـ 50 ألف ملف الخاصة بمشروعك بالكامل
COPY . .

# جعل المنفذ متوافقاً إجبارياً مع سياسة سيرفرات Hugging Face
ENV PORT=7860
EXPOSE 7860

# أمر تشغيل السيرفر المتكامل الخاص بك (تأكد من وجود أمر start في package.json)
CMD ["npm", "start"]
